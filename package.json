{
  "name": "nyaadl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/backend/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/backend/server.ts",
    "test": "tsx --test \"src/**/!(*.ignore).test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:local-library": "tsx src/scripts/validateLocalLibrary.ts",
    "report:fingerprint-combos": "tsx src/scripts/reportFingerprintCombos.ts",
    "legacy:cli": "bun run index.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.9.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@types/parse-torrent": "^5.8.8",
    "cheerio": "^1.2.0",
    "h3": "^2.0.1-rc.22",
    "parse-torrent": "^11.0.19",
    "solid-js": "^1.9.13"
  },
  "optionalDependencies": {
    "@arijs/stream-xml-parser": "../stream-xml-parser"
  }
}
